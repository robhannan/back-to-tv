<?xml version="1.0" encoding="utf-8"?>
<!-- 320x180 TV banner: a plain tile, no artwork. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="320dp" android:height="180dp" />
            <solid android:color="#1F2A44" />
        </shape>
    </item>
    <item android:gravity="center" android:width="96dp" android:height="64dp">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <stroke android:width="6dp" android:color="#FFFFFF" />
        </shape>
    </item>
</layer-list>
