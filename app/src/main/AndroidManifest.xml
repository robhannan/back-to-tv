<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The TV is reached over plain HTTP on the local network (CleanYourTV's MCP server). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 11+ package visibility: the other home screen apps, so OK can open the box's usual launcher. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/banner"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen"
        android:usesCleartextTraffic="true">

        <!-- The box's home screen. Backing out of an app lands here, and this sends the TV to its own Home. -->
        <activity
            android:name=".HomeActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- The box's remote drives the TV while the TV shows its own screens (LG's network remote, port 3000). -->
        <service
            android:name=".KeyForwardService"
            android:exported="false"
            android:label="@string/key_forward_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/key_forward" />
        </service>

        <!-- The box's screensaver slot: starts the TV's own screensaver while the TV shows the box's input. -->
        <service
            android:name=".SaverDream"
            android:exported="true"
            android:label="@string/saver_label"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- Debugging only: SSAP requests from adb (the shell holds DUMP; apps can't send this). -->
        <receiver
            android:name=".DebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="io.github.robhannan.backtotv.SSAP" />
            </intent-filter>
        </receiver>

        <!-- Settings: pairing with the TV, the box's input, the launcher to open on the box itself. -->
        <activity
            android:name=".SetupActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
